{
  "name": "mcp-client",
  "version": "1.2.0",
  "description": "Model Context Protocol客户端 - 工具调用演示",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && prisma generate && tsc && pnpm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "db:migrate": "prisma migrate deploy",
    "start": "pnpm run build && node dist/app.js",
    "server": "node dist/app.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.39.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "bullmq": "^5.77.4",
    "ioredis": "^5.11.0",
    "uuid": "^14.0.0",
    "@larksuiteoapi/node-sdk": "^1.66.0",
    "dingtalk-stream": "^2.1.6-beta.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0"
  }
}
