# 复制为 .env 后按需修改

# Prisma 7 SQLite：路径相对项目根目录（与 prisma.config.ts 同级）
# CLI 与运行时都从项目根 cwd 解析此相对路径，最终落到 prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# T1 消息总线（BullMQ + ioredis）；缺 REDIS_URL 时进程启动 throw
# 公司共享 Redis 请用运维提供的地址；key 前缀在代码 queue-names.ts 中配置
REDIS_URL="redis://用户名:密码@127.0.0.1:6379/0"

# Inbound Worker 并发数（可选，默认 5）
INBOUND_WORKER_CONCURRENCY=5

# T1-07 飞书渠道（@larksuiteoapi/node-sdk 长连接；未配置时不启动飞书 listener）
# 飞书开放平台 → 企业自建应用 → 凭证与基础信息
FEISHU_APP_ID="cli_xxxxxxxx"
FEISHU_APP_SECRET="xxxxxxxxxxxxxxxx"
# FEISHU_DOMAIN=lark  # 国际 Lark 租户用 lark；默认 feishu

# T1-08 钉钉渠道（dingtalk-stream Stream 长连接；未配置时不启动钉钉 listener）
# 钉钉开放平台 → 企业内部应用 → 凭证与基础信息（AppKey / AppSecret）
DINGTALK_CLIENT_ID="dingxxxxxxxx"
DINGTALK_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# T2 Admin API（渠道 Profile/Route 管理；与 /api/chat/* 分离）
# 请求头 X-Admin-Token 须与此一致；公开聊天 API 无需此变量
ADMIN_API_TOKEN="change-me-admin-token"