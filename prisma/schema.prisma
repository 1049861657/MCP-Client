// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 提供商类型枚举
enum ProviderType {
  OPENAI
}

// 连接类型枚举（远程 MCP 使用 Streamable HTTP，不再使用 SSE 命名）
enum ConnectionType {
  STDIO
  HTTP
}

// T2 配置平面：路由渠道（与 ChannelId 一致）
enum ConfigChannelId {
  web
  feishu
  dingtalk
}

// 通用设置模型
model Setting {
  key   String @id // 主键，例如 'defaultProvider', 'ChatConfig', 'HistoryConfig'
  value Json   // 存储设置值，对于复杂结构可以存储 JSON 字符串
}

// AI 提供商模型
model AIProvider {
  id                String         @id @default(cuid())
  name              String      @unique // 提供商名称
  type              ProviderType // 使用枚举类型
  apiUrl            String
  apiKey            String
  defaultModelValue String      // 该提供商的默认模型 value
  models            AIModel[]   // 关联的模型列表
}

// AI 模型模型
model AIModel {
  id         String        @id @default(cuid())
  value      String     // 模型的值
  label      String     // 模型的标签
  providerId String        // 外键
  provider   AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, value]) // 确保每个提供商下模型值唯一
}

// MCP 服务器模型
model MCPServer {
  id             String            @id @default(cuid())
  serverId       String         @unique // 对应 JSON 中的 id 字段
  name           String
  isActive       Boolean
  connectionType ConnectionType // 使用枚举类型
  command        String?        // stdio 类型可选
  args           Json?          // stdio 类型可选，存储 ["arg1", "arg2"]
  mcpUrl         String?        // HTTP 类型：MCP Streamable HTTP 端点
  headers        Json?          // HTTP 类型可选：自定义请求头，存储 {"key": "value"}
}

// T2：Agent 能力档案（模型、工具、Prompt 等）
model AgentProfile {
  id                    String        @id @default(cuid())
  profileId             String        @unique
  displayName           String
  vendor                String?
  defaultModel          String
  temperature           Float?
  maxTokens             Int?
  enableTools           Boolean       @default(true)
  enablePrompts         Boolean       @default(true)
  enableParamValidation Boolean       @default(false)
  maxToolCallRounds     Int           @default(25)
  enableAutoCompact     Boolean?
  compactModel          String?
  mcpServerIds          Json          @default("[]")
  toolPrompt            String?
  tenantId              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  routes                RouteRule[]
}

// T2：入站路由（channel + matchKey → profileId）
model RouteRule {
  id        String          @id @default(cuid())
  channel   ConfigChannelId
  matchKey  String
  profileId String
  priority  Int             @default(100)
  enabled   Boolean         @default(true)
  tenantId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  profile   AgentProfile    @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  @@unique([channel, matchKey])
  @@index([channel, enabled, priority])
}

// 快捷消息模型
model QuickMessage {
  id         String    @id @default(cuid())
  sortId     Int    @unique // 排序用
  content    String
  result     String
  category   String @default("默认")
}


